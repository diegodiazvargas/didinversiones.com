# Copia este archivo como referencia de las variables de entorno que necesita
# la función de Netlify del chatbot. NO se usa en local sin `netlify dev`,
# y este archivo (con valores reales) NUNCA debe subirse a git.
#
# En producción, esta variable se configura en:
# Netlify → Site settings → Environment variables

ANTHROPIC_API_KEY=sk-ant-...

# Opcional — por defecto usa claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5
